# PostgreSQL connection string (required).
# On Railway: add a Postgres database service to the project and set this to
# ${{ Postgres.DATABASE_URL }}.
DATABASE_URL=postgres://user:password@host:5432/mat

# Port is set automatically by Railway; defaults to 8081 locally.
# PORT=8081

# --- Authentication ---
# Without SESSION_SECRET the API runs completely open (local dev/preview only).
# Any long random string; generate with: openssl rand -hex 32
SESSION_SECRET=

# Comma-separated emails that are allowed to sign in.
ALLOWED_EMAILS=anna@example.com,bertil@example.com

# Google sign-in: OAuth 2.0 Web client ID from https://console.cloud.google.com/apis/credentials
# (add the site's origin under "Authorized JavaScript origins").
GOOGLE_CLIENT_ID=

# Apple sign-in (optional, needs an Apple Developer account): the Services ID.
# APPLE_CLIENT_ID=
