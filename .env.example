# MongoDB connection string (required)
# On Railway: set this in the service Variables tab, e.g. your Atlas URI
# or ${{ MongoDB.MONGO_URL }} if you use Railway's MongoDB plugin.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mat?retryWrites=true&w=majority

# Optional: separate URIs for prod/dev (fall back to MONGODB_URI)
# MONGODB_URI_PROD=
# MONGODB_URI_DEV=

# AWS credentials for the S3 image upload endpoint (/requestUploadURL)
# Only needed if you use image uploads.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1
# S3_UPLOAD_BUCKET=mat-cdn

# Port is set automatically by Railway; defaults to 8081 locally.
# PORT=8081
