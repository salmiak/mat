# MongoDB connection string (required)
# On Railway: add a MongoDB database service to the project and set this to
# ${{ MongoDB.MONGO_URL }} (or use your own MongoDB Atlas URI).
MONGODB_URI=mongodb://user:password@host:27017/mat

# Optional: separate URIs for prod/dev (fall back to MONGODB_URI)
# MONGODB_URI_PROD=
# MONGODB_URI_DEV=

# Directory where uploaded files (recipe images) are stored.
# On Railway: mount a volume on the service and point this at the mount path.
# Defaults to server/uploads locally.
# UPLOAD_DIR=/data/uploads

# Port is set automatically by Railway; defaults to 8081 locally.
# PORT=8081
